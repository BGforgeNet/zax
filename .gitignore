node_modules/
dist/
# Committed: an action runs from the repository at its caller's ref, with nothing built. CI checks it is current.
!/actions/mod-ini/dist/
tmp/

# What `pnpm test:coverage` writes.
coverage/

# The distributables electron-builder writes. A portable copy's `data` directory sits beside its executable, so
# one made from a checkout lands under here or under node_modules, and needs no pattern of its own - which is
# just as well, since `data` is what a Fallout install calls its own content directory.
release/

# Scratch: the extraction scripts and fetched upstream sources the catalog generators read.
.work/

# What cargo builds into. Cargo.lock is committed: the crates here build a binary, not a library.
target/

# Capability schemas tauri-build regenerates on every build from tauri.conf.json.
crates/shell/gen/schemas/

# The browser preview's WebAssembly, which `scripts/build-preview.sh` writes. A build artifact rather than
# a generated source: it is megabytes of binary, and nothing reads it but the page that loads it.
packages/ui/src/lib/preview-wasm/

# Per-user state the application writes, when it is run from a checkout.
zax.yml

.playwright*
