    },
    {
      "section": "ui",
      "key": "anim_speed",
      "kind": "real",
      "min": 0.1,
      "max": 100,
      "default": "2.000000",
      "help": "Speed up or slow down all UI animations such as screen fade, dialog window show/hide, AC numbers roll, etc."
    },
    {
      "section": "ui",
      "key": "skip_opening_movies",
      "kind": "number",
      "min": 0,
      "max": 2,
      "default": "0",
