    {
      "section": "screen",
      "key": "windowed",
      "kind": "number",
      "clamp": "WindowMode::Fullscreen, WindowMode::WindowedFullscreen",
      "default": "1",
      "help": "Set to 0 to run the game in fullscreen mode. Set to 1 to run the game in windowed mode. Set to 2 to run in borderless windowed (windowed fullscreen) mode."
    },
    {
      "section": "screen",
      "key": "mouse_lock",
      "kind": "bool",
      "default": "0",
      "help": "Set to 1 to lock the mouse to the game window in windowed or windowed fullscreen mode. Set to 0 to use the OS cursor normally. Mouse is always locked in non-windowed fullscreen mode."
    },
    {
      "section": "screen",
      "key": "scale",
      "kind": "number",
      "min": 1,
      "max": 4,
      "default": "1",
      "help": "Scale of physical pixels to logical pixels.  For instance, if x/y is 1280 x 960 and scale is 2, the game will be rendered at 640 x 480 and then scaled up to 1280 x 960.  This is useful for windowed mode on high DPI displays."
    },
    {
      "section": "ui",
      "key": "main_menu_scale_mode",
      "kind": "number",
      "min": 0,
      "max": 2,
      "default": "1",
      "help": "Set to 0 to keep the main menu art and controls at native size. Set to 1 to scale only the main menu background image to fit the screen while maintaining aspect ratio. Set to 2 to also scale the main menu button panel, red buttons, and button labels with the menu art."
    },
    {
      "section": "ui",
      "key": "in_game_menu_help",
      "kind": "bool",
      "default": "1",
      "help": "Set to 1 to show a Help option in the in-game options menu which opens the F1 help screen."
    },
    {
      "section": "ui",
      "key": "iface_bar_mode",
      "kind": "bool",
      "default": "0",
      "help": "if iface_bar_mode=0 - the bottom of the map view window sits at the top of the IFACE Bar. if iface_bar_mode=1 - the bottom of the map view window extends to the base of the screen and is overlapped by the IFACE Bar."
    },
    {
      "section": "ui",
      "key": "perks_progress_bar",
      "kind": "bool"
    },
    {
      "section": "ui",
      "key": "iface_bar_width",
      "kind": "number",
      "min": 640,
      "max": 4320,
      "default": "800",
      "help": "Set to 640 to use the original interface bar width, or 800 to use the 800pix wide asset from f2_res.dat."
    },
    {
      "section": "ui",
      "key": "iface_bar_side_art",
      "kind": "number",
      "min": 0,
      "max": 999,
      "default": "2",
      "help": "0 = no side art, 1 = metal, 2 = leather, 3-6 = alternative metal, 7 = alternative leather, 8 = brown metal"
    },
    {
      "section": "ui",
      "key": "iface_bar_sides_ori",
      "kind": "bool",
      "default": "0",
      "help": "0 = Iface-bar side graphics extend from the Iface-Bar to the Screen edges. 1 = Iface-bar side graphics extend from the Screen edges to the Iface-Bar"
    },
    {
      "section": "ui",
      "key": "alternate_ammo_meter",
      "kind": "number",
      "min": 0,
      "max": 2,
      "default": "1",
      "help": "Set to 1 to use the HRP-style alternate ammo meter with burst segments, or 2 to also segment single-shot firearms with up to 6 shots."
    },
    {
      "section": "ui",
      "key": "splash_screen_size",
      "kind": "number",
      "min": 0,
      "max": 2,
      "default": "1",
      "help": "Set to 1 to scale the splash screen to fit the screen while preserving aspect ratio. Set to 2 to fill the screen"
    },
    {
      "section": "ui",
      "key": "movie_aspect_fit",
      "kind": "bool",
      "default": "1",
      "help": "Set to 1 to scale movies to fit the screen while preserving aspect ratio. Set to 0 to keep movies at their native size, centered on screen."
    },
    {
      "section": "ui",
      "key": "edg_support",
      "kind": "bool",
      "default": "1",
      "help": "Whether to load EDG files (HRP format) when loading maps. If loaded, they override default edge clipping and scroll blocking behavior."
    },
    {
      "section": "ui",
      "key": "ignore_scroll_limit",
      "kind": "bool",
      "default": "0",
      "help": "Set to 1 to ignore the player-centered map scroll limit."
    },
    {
      "section": "ui",
      "key": "ignore_map_edges",
      "kind": "bool",
      "default": "0"
    },
    {
      "section": "ui",
