{
  "name": "@zax/app",
  "version": "0.8.0",
  "private": true,
  "description": "Configuration and mod manager for Fallout 2",
  "author": "BGforge",
  "homepage": "https://github.com/BGforgeNet/zax",
  "main": "./dist/main.mjs",
  "desktopName": "net.bgforge.zax.desktop",
  "dependencies": {
    "7z-wasm": "1.2.0"
  },
  "devDependencies": {
    "@zax/core": "workspace:*",
    "@zax/fallout2": "workspace:*",
    "@zax/platform": "workspace:*",
    "@zax/platform-node": "workspace:*",
    "electron": "44.0.0",
    "electron-builder": "26.15.7",
    "esbuild": "0.28.2"
  },
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "package": "pnpm build && electron-builder --publish never",
    "package:dir": "pnpm build && electron-builder --dir --publish never"
  }
}
