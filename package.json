{
  "name": "zax",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @zax/ui dev",
    "build": "pnpm --filter @zax/ui build",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && pnpm --filter @zax/ui exec svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "gen:icons": "node scripts/gen-icons.mjs",
    "verify:chokidar": "node scripts/verify-chokidar.mjs",
    "desktop": "pnpm --filter @zax/app build && pnpm --filter @zax/app start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.22.0",
    "fast-check": "^4.3.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
