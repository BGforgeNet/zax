{
  "name": "zax",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "pnpm --filter @zax/ui dev",
    "build": "pnpm --filter @zax/ui build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "drive": "vitest run --config vitest.e2e.config.ts",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json && pnpm --filter @zax/ui exec svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint --type-aware && eslint . && oxfmt --check",
    "knip": "knip",
    "format": "oxfmt --write",
    "check-manifest": "node scripts/check-manifest.mjs",
    "mod-ini": "node actions/mod-ini/cli.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "verify:chokidar": "node scripts/verify-chokidar.mjs",
    "desktop": "tauri dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.8",
    "jiti": "^2.7.0",
    "knip": "6.32.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "svelte": "^5.56.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yaml": "2.9.0"
  }
}
