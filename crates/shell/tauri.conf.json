{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZAX",
  "mainBinaryName": "zax",
  "version": "../../package.json",
  "identifier": "net.bgforge.zax",
  "build": {
    "frontendDist": "../../packages/ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../.." },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../.." }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Configuration and mod manager for Fallout 2",
    "publisher": "BGforge"
  }
}
